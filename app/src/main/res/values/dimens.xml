<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         Design Tokens — 8dp grid spacing system.
         Use these everywhere in layouts instead of hardcoded values.
         ============================================================ -->

    <!-- Spacing scale -->
    <dimen name="spacing_xxs">2dp</dimen>
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_s">8dp</dimen>
    <dimen name="spacing_m">12dp</dimen>
    <dimen name="spacing_l">16dp</dimen>
    <dimen name="spacing_xl">20dp</dimen>
    <dimen name="spacing_xxl">24dp</dimen>
    <dimen name="spacing_xxxl">32dp</dimen>

    <!-- Screen edge gutter — keep consistent across all screens -->
    <dimen name="screen_horizontal_padding">20dp</dimen>
    <dimen name="screen_vertical_padding">16dp</dimen>
    <dimen name="content_horizontal_padding">16dp</dimen>

    <!-- Corner radii -->
    <dimen name="radius_xs">4dp</dimen>
    <dimen name="radius_s">8dp</dimen>
    <dimen name="radius_m">12dp</dimen>
    <dimen name="radius_l">16dp</dimen>
    <dimen name="radius_xl">20dp</dimen>
    <dimen name="radius_pill">28dp</dimen>

    <!-- Elevation scale -->
    <dimen name="elevation_none">0dp</dimen>
    <dimen name="elevation_low">2dp</dimen>
    <dimen name="elevation_card">4dp</dimen>
    <dimen name="elevation_floating">8dp</dimen>
    <dimen name="elevation_modal">12dp</dimen>

    <!-- Component heights -->
    <dimen name="button_height">48dp</dimen>
    <dimen name="button_height_small">40dp</dimen>
    <dimen name="input_height">56dp</dimen>
    <dimen name="touch_target_min">48dp</dimen>
    <dimen name="toolbar_height">56dp</dimen>

    <!-- Icon sizes -->
    <dimen name="icon_xs">16dp</dimen>
    <dimen name="icon_s">20dp</dimen>
    <dimen name="icon_m">24dp</dimen>
    <dimen name="icon_l">32dp</dimen>
    <dimen name="icon_xl">40dp</dimen>
    <dimen name="icon_button">42dp</dimen>

    <!-- Card stroke widths used by payment method selector -->
    <dimen name="card_stroke_selected">2dp</dimen>
    <dimen name="card_stroke_default">1dp</dimen>

    <!-- Text size scale -->
    <dimen name="text_caption">11sp</dimen>
    <dimen name="text_label">12sp</dimen>
    <dimen name="text_body_small">13sp</dimen>
    <dimen name="text_body">14sp</dimen>
    <dimen name="text_subtitle">15sp</dimen>
    <dimen name="text_title_small">16sp</dimen>
    <dimen name="text_title">18sp</dimen>
    <dimen name="text_title_large">20sp</dimen>
    <dimen name="text_headline_small">22sp</dimen>
    <dimen name="text_headline">24sp</dimen>
    <dimen name="text_display">28sp</dimen>
</resources>
