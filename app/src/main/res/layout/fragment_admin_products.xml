<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buyon_bg_primary"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        style="@style/Widget.Buyon.AppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_horizontal_padding"
            android:paddingTop="@dimen/spacing_l"
            android:paddingEnd="@dimen/content_horizontal_padding"
            android:paddingBottom="@dimen/spacing_m">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Products"
                android:textAppearance="@style/TextAppearance.Buyon.Headline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_product"
                style="@style/Widget.Buyon.Button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:minHeight="0dp"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:text="+ Add"
                android:textSize="@dimen/text_body_small" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_products"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/content_horizontal_padding"
        android:paddingTop="@dimen/spacing_s"
        android:paddingEnd="@dimen/content_horizontal_padding"
        android:paddingBottom="@dimen/spacing_xxl"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_admin_product" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="No products yet"
        android:textAppearance="@style/TextAppearance.Buyon.BodySecondary"
        android:textSize="@dimen/text_title_small"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
