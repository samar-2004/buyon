<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buyon_bg_secondary"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_xxxl">

            <!-- Header Banner — orange gradient for premium admin feel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/buyon_primary"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_horizontal_padding"
                android:paddingTop="@dimen/spacing_xxxl"
                android:paddingEnd="@dimen/screen_horizontal_padding"
                android:paddingBottom="@dimen/spacing_xxxl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ADMIN CONTROL"
                            android:textColor="#80FFFFFF"
                            android:letterSpacing="0.1"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="Dashboard"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_display"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/last_updated"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:textColor="#B3FFFFFF"
                            android:textSize="@dimen/text_label"
                            tools:text="Last updated: Just now" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_logout"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_log_out"
                        android:textColor="@color/white"
                        app:strokeColor="#80FFFFFF"
                        app:strokeWidth="1dp"
                        app:rippleColor="#33FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- Stats Cards Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/content_horizontal_padding"
                android:paddingTop="@dimen/spacing_xl"
                android:paddingEnd="@dimen/content_horizontal_padding">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Revenue card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_s"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/buyon_card"
                        app:cardCornerRadius="@dimen/radius_l"
                        app:cardElevation="@dimen/elevation_card"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_l">

                            <FrameLayout
                                android:layout_width="@dimen/icon_xl"
                                android:layout_height="@dimen/icon_xl"
                                android:background="@drawable/bg_circle_primary">

                                <ImageView
                                    android:layout_width="@dimen/icon_m"
                                    android:layout_height="@dimen/icon_m"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_admin_dashboard"
                                    app:tint="@color/white" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_m"
                                android:text="Revenue"
                                android:textColor="@color/buyon_text_secondary"
                                android:textSize="@dimen/text_label" />

                            <TextView
                                android:id="@+id/stat_revenue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xxs"
                                android:textColor="@color/buyon_primary"
                                android:textSize="@dimen/text_title_large"
                                android:textStyle="bold"
                                tools:text="$12.4K" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Orders card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/buyon_card"
                        app:cardCornerRadius="@dimen/radius_l"
                        app:cardElevation="@dimen/elevation_card"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_l">

                            <FrameLayout
                                android:layout_width="@dimen/icon_xl"
                                android:layout_height="@dimen/icon_xl"
                                android:background="@drawable/bg_circle_surface">

                                <ImageView
                                    android:layout_width="@dimen/icon_m"
                                    android:layout_height="@dimen/icon_m"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_admin_orders"
                                    app:tint="@color/buyon_text_primary" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_m"
                                android:text="Orders"
                                android:textColor="@color/buyon_text_secondary"
                                android:textSize="@dimen/text_label" />

                            <TextView
                                android:id="@+id/stat_orders"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xxs"
                                android:textColor="@color/buyon_text_primary"
                                android:textSize="@dimen/text_title_large"
                                android:textStyle="bold"
                                tools:text="248" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:orientation="horizontal">

                    <!-- Users card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_s"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/buyon_card"
                        app:cardCornerRadius="@dimen/radius_l"
                        app:cardElevation="@dimen/elevation_card"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_l">

                            <FrameLayout
                                android:layout_width="@dimen/icon_xl"
                                android:layout_height="@dimen/icon_xl"
                                android:background="@drawable/bg_circle_surface">

                                <ImageView
                                    android:layout_width="@dimen/icon_m"
                                    android:layout_height="@dimen/icon_m"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_admin_users"
                                    app:tint="@color/buyon_text_primary" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_m"
                                android:text="Active Users"
                                android:textColor="@color/buyon_text_secondary"
                                android:textSize="@dimen/text_label" />

                            <TextView
                                android:id="@+id/stat_users"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xxs"
                                android:textColor="@color/buyon_text_primary"
                                android:textSize="@dimen/text_title_large"
                                android:textStyle="bold"
                                tools:text="1.2K" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Products card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/buyon_card"
                        app:cardCornerRadius="@dimen/radius_l"
                        app:cardElevation="@dimen/elevation_card"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_l">

                            <FrameLayout
                                android:layout_width="@dimen/icon_xl"
                                android:layout_height="@dimen/icon_xl"
                                android:background="@drawable/bg_circle_surface">

                                <ImageView
                                    android:layout_width="@dimen/icon_m"
                                    android:layout_height="@dimen/icon_m"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_admin_products"
                                    app:tint="@color/buyon_text_primary" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_m"
                                android:text="Products"
                                android:textColor="@color/buyon_text_secondary"
                                android:textSize="@dimen/text_label" />

                            <TextView
                                android:id="@+id/stat_products"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xxs"
                                android:textColor="@color/buyon_text_primary"
                                android:textSize="@dimen/text_title_large"
                                android:textStyle="bold"
                                tools:text="86" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- Revenue Analytics Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/content_horizontal_padding"
                android:layout_marginTop="@dimen/spacing_xl"
                android:layout_marginEnd="@dimen/content_horizontal_padding"
                app:cardBackgroundColor="@color/buyon_card"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="@dimen/elevation_card"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Revenue Analytics"
                            android:textColor="@color/buyon_text_primary"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip_analytics_7_days"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_category_chip_selected"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:text="7d"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_caption" />

                            <TextView
                                android:id="@+id/chip_analytics_this_week"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xs"
                                android:background="@drawable/bg_category_chip"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:text="Week"
                                android:textColor="@color/buyon_text_secondary"
                                android:textSize="@dimen/text_caption" />

                            <TextView
                                android:id="@+id/chip_analytics_last_week"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xs"
                                android:background="@drawable/bg_category_chip"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:text="Prev"
                                android:textColor="@color/buyon_text_secondary"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Summary row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/analytics_this_week"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/buyon_text_primary"
                            android:textSize="@dimen/text_title"
                            android:textStyle="bold"
                            tools:text="$2,430" />

                        <TextView
                            android:id="@+id/analytics_week_compare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_category_chip_selected"
                            android:paddingStart="@dimen/spacing_s"
                            android:paddingTop="@dimen/spacing_xxs"
                            android:paddingEnd="@dimen/spacing_s"
                            android:paddingBottom="@dimen/spacing_xxs"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold"
                            tools:text="+12.5%" />
                    </LinearLayout>

                    <!-- Bar chart -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="@dimen/spacing_l"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/bar_day_0"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:alpha="0.4"
                            android:background="@drawable/bg_button_primary" />

                        <View
                            android:id="@+id/bar_day_1"
                            android:layout_width="0dp"
                            android:layout_height="68dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:alpha="0.55"
                            android:background="@drawable/bg_button_primary" />

                        <View
                            android:id="@+id/bar_day_2"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:alpha="0.65"
                            android:background="@drawable/bg_button_primary" />

                        <View
                            android:id="@+id/bar_day_3"
                            android:layout_width="0dp"
                            android:layout_height="84dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:alpha="0.75"
                            android:background="@drawable/bg_button_primary" />

                        <View
                            android:id="@+id/bar_day_4"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:alpha="0.8"
                            android:background="@drawable/bg_button_primary" />

                        <View
                            android:id="@+id/bar_day_5"
                            android:layout_width="0dp"
                            android:layout_height="96dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:alpha="0.9"
                            android:background="@drawable/bg_button_primary" />

                        <View
                            android:id="@+id/bar_day_6"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_primary" />
                    </LinearLayout>

                    <!-- Day labels -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/label_day_0"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="M"
                            android:textColor="@color/buyon_text_secondary"
                            android:textSize="@dimen/text_caption" />

                        <TextView
                            android:id="@+id/label_day_1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="T"
                            android:textColor="@color/buyon_text_secondary"
                            android:textSize="@dimen/text_caption" />

                        <TextView
                            android:id="@+id/label_day_2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="W"
                            android:textColor="@color/buyon_text_secondary"
                            android:textSize="@dimen/text_caption" />

                        <TextView
                            android:id="@+id/label_day_3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="T"
                            android:textColor="@color/buyon_text_secondary"
                            android:textSize="@dimen/text_caption" />

                        <TextView
                            android:id="@+id/label_day_4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="F"
                            android:textColor="@color/buyon_text_secondary"
                            android:textSize="@dimen/text_caption" />

                        <TextView
                            android:id="@+id/label_day_5"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="S"
                            android:textColor="@color/buyon_text_secondary"
                            android:textSize="@dimen/text_caption" />

                        <TextView
                            android:id="@+id/label_day_6"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="S"
                            android:textColor="@color/buyon_primary"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Actions -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_horizontal_padding"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:layout_marginEnd="@dimen/screen_horizontal_padding"
                android:text="Quick Actions"
                android:textColor="@color/buyon_text_primary"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/content_horizontal_padding"
                android:layout_marginTop="@dimen/spacing_m"
                android:layout_marginEnd="@dimen/content_horizontal_padding"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/buyon_primary_ultra_light"
                    app:cardCornerRadius="@dimen/radius_l"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/buyon_primary_alpha"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_l">

                        <ImageView
                            android:layout_width="@dimen/icon_l"
                            android:layout_height="@dimen/icon_l"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_admin_products"
                            app:tint="@color/buyon_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_s"
                            android:text="Products"
                            android:textColor="@color/buyon_primary"
                            android:textSize="@dimen/text_label"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/buyon_surface_2"
                    app:cardCornerRadius="@dimen/radius_l"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/buyon_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_l">

                        <ImageView
                            android:layout_width="@dimen/icon_l"
                            android:layout_height="@dimen/icon_l"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_admin_orders"
                            app:tint="@color/buyon_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_s"
                            android:text="Orders"
                            android:textColor="@color/buyon_text_primary"
                            android:textSize="@dimen/text_label"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/buyon_surface_2"
                    app:cardCornerRadius="@dimen/radius_l"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/buyon_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_l">

                        <ImageView
                            android:layout_width="@dimen/icon_l"
                            android:layout_height="@dimen/icon_l"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_admin_users"
                            app:tint="@color/buyon_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_s"
                            android:text="Users"
                            android:textColor="@color/buyon_text_primary"
                            android:textSize="@dimen/text_label"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Recent Orders Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_horizontal_padding"
                android:paddingTop="@dimen/spacing_xxl"
                android:paddingEnd="@dimen/screen_horizontal_padding">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Orders"
                    android:textColor="@color/buyon_text_primary"
                    android:textSize="@dimen/text_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/spacing_xs"
                    android:text="See all"
                    android:textColor="@color/buyon_primary"
                    android:textSize="@dimen/text_body_small"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_recent_orders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/content_horizontal_padding"
                android:paddingTop="@dimen/spacing_s"
                android:paddingEnd="@dimen/content_horizontal_padding"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_admin_order" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
