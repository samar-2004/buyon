<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_m"
    app:cardBackgroundColor="@color/buyon_card"
    app:cardCornerRadius="@dimen/radius_l"
    app:cardElevation="@dimen/elevation_card"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_l">

        <!-- Order ID + Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/order_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/buyon_text_primary"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold"
                tools:text="#AB12CD34" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pending"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/spacing_m"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingEnd="@dimen/spacing_m"
                android:paddingBottom="@dimen/spacing_xs"
                android:textColor="@color/status_pending"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                tools:text="PLACED" />
        </LinearLayout>

        <!-- Customer info -->
        <TextView
            android:id="@+id/customer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:textColor="@color/buyon_text_primary"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            tools:text="Sara Khan" />

        <TextView
            android:id="@+id/customer_contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxs"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/buyon_text_secondary"
            android:textSize="@dimen/text_label"
            tools:text="sara@email.com | +92 300 0000000" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_m"
            android:layout_marginBottom="@dimen/spacing_m"
            android:background="@color/buyon_divider" />

        <!-- Total + Payment + Item count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/buyon_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                tools:text="$348.00" />

            <TextView
                android:id="@+id/payment_method"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:background="@drawable/bg_category_chip"
                android:paddingStart="@dimen/spacing_m"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingEnd="@dimen/spacing_m"
                android:paddingBottom="@dimen/spacing_xs"
                android:textColor="@color/buyon_text_secondary"
                android:textSize="@dimen/text_caption"
                tools:text="COD" />

            <TextView
                android:id="@+id/item_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_category_chip"
                android:paddingStart="@dimen/spacing_m"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingEnd="@dimen/spacing_m"
                android:paddingBottom="@dimen/spacing_xs"
                android:textColor="@color/buyon_text_secondary"
                android:textSize="@dimen/text_caption"
                tools:text="4 items" />
        </LinearLayout>

        <!-- Date -->
        <TextView
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:textColor="@color/buyon_text_hint"
            android:textSize="@dimen/text_caption"
            tools:text="Jan 1, 2024  10:30" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
