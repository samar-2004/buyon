<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buyon_bg_primary"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Hero Image ──────────────────────────────────────────── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="380dp">

                <ImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/buyon_card"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <!-- Dark gradient so back/wish buttons stay readable -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_scrim_top" />

                <!-- Bottom gradient for smooth transition into sheet -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_scrim_bottom" />

                <!-- Floating nav row (insets applied in code) -->
                <LinearLayout
                    android:id="@+id/nav_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_l"
                    android:paddingTop="@dimen/spacing_l"
                    android:paddingEnd="@dimen/spacing_l">

                    <ImageView
                        android:id="@+id/btn_back"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_circle_surface"
                        android:contentDescription="@null"
                        android:padding="@dimen/spacing_s"
                        android:src="@drawable/ic_arrow_back" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btn_wishlist"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_circle_surface"
                        android:contentDescription="@null"
                        android:padding="@dimen/spacing_s"
                        android:src="@drawable/ic_heart_outline" />
                </LinearLayout>
            </FrameLayout>

            <!-- ── Content Sheet ───────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-28dp"
                android:background="@drawable/bg_sheet_rounded"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_horizontal_padding"
                android:paddingTop="@dimen/spacing_m"
                android:paddingEnd="@dimen/screen_horizontal_padding"
                android:paddingBottom="@dimen/spacing_xl">

                <!-- Handle bar -->
                <View
                    android:layout_width="48dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/spacing_l"
                    android:background="@color/buyon_stroke" />

                <!-- Product name -->
                <TextView
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Buyon.Headline"
                    android:textSize="@dimen/text_headline_small"
                    tools:text="Premium Wireless Headphones" />

                <!-- Rating + sold + location row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_xs"
                        android:layout_height="@dimen/icon_xs"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star" />

                    <TextView
                        android:id="@+id/meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:textAppearance="@style/TextAppearance.Buyon.BodySmall"
                        tools:text="4.8 · 250+ sold" />

                    <ImageView
                        android:id="@+id/icon_location"
                        android:layout_width="@dimen/icon_xs"
                        android:layout_height="@dimen/icon_xs"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_location" />

                    <TextView
                        android:id="@+id/text_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:textAppearance="@style/TextAppearance.Buyon.BodySmall"
                        tools:text="South Jakarta" />
                </LinearLayout>

                <!-- Price row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Price"
                            android:textAppearance="@style/TextAppearance.Buyon.Label" />

                        <TextView
                            android:id="@+id/price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxs"
                            android:textAppearance="@style/TextAppearance.Buyon.Display"
                            android:textColor="@color/buyon_primary"
                            android:textStyle="bold"
                            tools:text="$348" />
                    </LinearLayout>

                    <!-- Stock badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_category_chip_selected"
                        android:paddingStart="@dimen/spacing_m"
                        android:paddingTop="@dimen/spacing_xs"
                        android:paddingEnd="@dimen/spacing_m"
                        android:paddingBottom="@dimen/spacing_xs"
                        android:text="In Stock"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_label"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:layout_marginBottom="@dimen/spacing_l"
                    android:background="@color/buyon_divider" />

                <!-- Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/product_description_header"
                    android:textAppearance="@style/TextAppearance.Buyon.TitleSmall"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:lineSpacingMultiplier="1.6"
                    android:textAppearance="@style/TextAppearance.Buyon.BodySecondary"
                    tools:text="High quality product with premium features and exceptional build quality. Designed for everyday use with attention to detail." />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:layout_marginBottom="@dimen/spacing_l"
                    android:background="@color/buyon_divider" />

                <!-- Quantity row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quantity"
                            android:textAppearance="@style/TextAppearance.Buyon.TitleSmall"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxs"
                            android:text="Select how many"
                            android:textAppearance="@style/TextAppearance.Buyon.Label" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/spacing_xs"
                        android:paddingTop="@dimen/spacing_xs"
                        android:paddingEnd="@dimen/spacing_xs"
                        android:paddingBottom="@dimen/spacing_xs">

                        <ImageView
                            android:id="@+id/btn_minus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_surface"
                            android:contentDescription="@null"
                            android:padding="@dimen/spacing_s"
                            android:src="@drawable/ic_minus" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_qty"
                            android:layout_width="50dp"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:inputType="number"
                            android:text="1"
                            android:textColor="@color/buyon_text_primary"
                            android:textSize="@dimen/text_title_small"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/btn_plus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_primary"
                            android:contentDescription="@null"
                            android:padding="@dimen/spacing_s"
                            android:src="@drawable/ic_add" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Sticky Bottom Bar ───────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/sticky_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/buyon_surface"
        android:elevation="@dimen/elevation_floating"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/spacing_m"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="@dimen/spacing_l">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Price"
                android:textAppearance="@style/TextAppearance.Buyon.Label" />

            <TextView
                android:id="@+id/price_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:textAppearance="@style/TextAppearance.Buyon.Title"
                android:textColor="@color/buyon_primary"
                android:textSize="@dimen/text_title_large"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="$348"
                tools:visibility="visible" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="@dimen/button_height">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_cart"
                style="@style/Widget.Buyon.Button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/add_to_cart"
                android:textSize="@dimen/text_subtitle" />

            <ProgressBar
                android:id="@+id/progress_add_cart"
                style="?android:attr/progressBarStyle"
                android:layout_width="@dimen/icon_m"
                android:layout_height="@dimen/icon_m"
                android:layout_gravity="center"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
