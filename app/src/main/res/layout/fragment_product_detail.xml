<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buyon_bg_primary"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        style="@style/Widget.Buyon.AppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_s"
            android:paddingTop="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_l"
            android:paddingBottom="@dimen/spacing_s">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="@dimen/icon_xl"
                android:layout_height="@dimen/icon_xl"
                android:background="@drawable/bg_circle_surface"
                android:contentDescription="@null"
                android:padding="@dimen/spacing_m"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_weight="1"
                android:text="@string/product_detail"
                android:textAppearance="@style/TextAppearance.Buyon.Toolbar"
                android:textSize="@dimen/text_title" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Product image - full width with gradient overlay -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp">

                <ImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/buyon_card"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_splash_gradient" />
            </FrameLayout>

            <!-- Product info card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/content_horizontal_padding"
                android:layout_marginTop="-20dp"
                android:layout_marginEnd="@dimen/content_horizontal_padding"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Buyon.Title"
                    android:textSize="@dimen/text_title_large"
                    tools:text="Premium Wireless Headphones" />

                <!-- Rating & meta -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_xs"
                        android:layout_height="@dimen/icon_xs"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star" />

                    <TextView
                        android:id="@+id/meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:textAppearance="@style/TextAppearance.Buyon.BodySmall"
                        tools:text="4.8 · 250+ sold" />

                    <ImageView
                        android:id="@+id/icon_location"
                        android:layout_width="@dimen/icon_xs"
                        android:layout_height="@dimen/icon_xs"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_location" />

                    <TextView
                        android:id="@+id/text_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:text="South Jakarta"
                        android:textAppearance="@style/TextAppearance.Buyon.BodySmall" />
                </LinearLayout>

                <TextView
                    android:id="@+id/price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:textAppearance="@style/TextAppearance.Buyon.Display"
                    android:textColor="@color/buyon_primary"
                    tools:text="$ 348" />
            </LinearLayout>

            <!-- Description card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/content_horizontal_padding"
                android:layout_marginTop="@dimen/spacing_m"
                android:layout_marginEnd="@dimen/content_horizontal_padding"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/product_description_header"
                    android:textAppearance="@style/TextAppearance.Buyon.TitleSmall"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:lineSpacingMultiplier="1.4"
                    android:textAppearance="@style/TextAppearance.Buyon.BodySecondary"
                    tools:text="High quality product with premium features and exceptional build quality." />
            </LinearLayout>

            <!-- Quantity selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/content_horizontal_padding"
                android:layout_marginTop="@dimen/spacing_m"
                android:layout_marginEnd="@dimen/content_horizontal_padding"
                android:background="@drawable/bg_card_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_l">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Quantity"
                    android:textAppearance="@style/TextAppearance.Buyon.TitleSmall"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_xs">

                    <ImageView
                        android:id="@+id/btn_minus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_circle_surface"
                        android:contentDescription="@null"
                        android:padding="@dimen/spacing_s"
                        android:src="@drawable/ic_minus" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_qty"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="1"
                        android:textColor="@color/buyon_text_primary"
                        android:textSize="@dimen/text_title_small"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btn_plus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_circle_primary"
                        android:contentDescription="@null"
                        android:padding="@dimen/spacing_s"
                        android:src="@drawable/ic_add" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Add to Cart bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/buyon_surface"
        android:elevation="@dimen/elevation_floating"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/spacing_m"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="@dimen/spacing_l">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Price"
                android:textAppearance="@style/TextAppearance.Buyon.Label" />

            <TextView
                android:id="@+id/price_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Buyon.Title"
                android:textColor="@color/buyon_primary"
                android:textSize="@dimen/text_title_large"
                android:visibility="gone"
                tools:text="$ 348"
                tools:visibility="visible" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="@dimen/button_height">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_cart"
                style="@style/Widget.Buyon.Button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/add_to_cart"
                android:textSize="@dimen/text_subtitle" />

            <ProgressBar
                android:id="@+id/progress_add_cart"
                style="?android:attr/progressBarStyle"
                android:layout_width="@dimen/icon_m"
                android:layout_height="@dimen/icon_m"
                android:layout_gravity="center"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
