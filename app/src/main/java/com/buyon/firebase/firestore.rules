rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // users/{uid} profile docs
    match /users/{uid} {
      // Owner or admin can read profile
      allow read: if isOwner(uid) || isAdmin();

      // User can create own profile only as role "user"
      allow create: if isOwner(uid) &&
        request.resource.data.role == "user";

      // Owner can update own profile except role changes
      allow update: if isOwner(uid) &&
        request.resource.data.role == resource.data.role;

      // Admin can update/delete any user (including role management)
      allow update, delete: if isAdmin();
    }

    // users/{uid}/cart/{itemId}
    match /users/{uid}/cart/{itemId} {
      allow read, write: if isOwner(uid);
    }

    // Public catalog; admin writes
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // wishlist/{uid}/items/{productId}
    match /wishlist/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // orders/{orderId}
    match /orders/{orderId} {
      // User reads own orders; admin reads all
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // User creates only for self; admin can also create
      allow create: if isSignedIn() &&
        (request.resource.data.userId == request.auth.uid || isAdmin());

      // Admin updates/deletes
      allow update, delete: if isAdmin();
    }

    // payments/{paymentId}
    match /payments/{paymentId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        (request.resource.data.userId == request.auth.uid || isAdmin());

      // Keep this strict in production (prefer Cloud Functions)
      allow update: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow delete: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll([
            'userId', 'createdAt', 'subtotal', 'discount', 'shippingFee', 'total',
            'shippingAddress', 'promoCode', 'status', 'lines'
          ]);
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /cart/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
