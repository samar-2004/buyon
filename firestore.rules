rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validUserRole(role) {
      return role == 'user' || role == 'admin';
    }

    function validCartItem() {
      return request.resource.data.keys().hasOnly(['name', 'unitPrice', 'imageUrl', 'quantity'])
        && request.resource.data.name is string
        && request.resource.data.unitPrice is number
        && request.resource.data.imageUrl is string
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0;
    }

    function validWishlistItem() {
      return request.resource.data.keys().hasAll(['productId', 'name', 'price', 'imageUrl'])
        && request.resource.data.keys().hasOnly(['productId', 'name', 'price', 'imageUrl', 'timestamp', 'addedAt'])
        && request.resource.data.productId is string
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.imageUrl is string;
    }

    function validOrderCreate() {
      return request.resource.data.keys().hasAll([
        'userId', 'createdAt', 'subtotal', 'shippingFee', 'total',
        'shippingAddress', 'promoCode', 'status', 'lines',
        'paymentMethod', 'paymentStatus', 'paymentReference'
      ])
      && request.resource.data.userId == request.auth.uid
      && request.resource.data.status is string
      && request.resource.data.lines is list
      && request.resource.data.subtotal is number
      && request.resource.data.shippingFee is number
      && request.resource.data.total is number;
    }

    function validPaymentCreate() {
      return request.resource.data.keys().hasAll([
        'userId', 'amount', 'method', 'status', 'transactionRef', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.userId == request.auth.uid
      && request.resource.data.amount is number
      && request.resource.data.method is string
      && request.resource.data.status is string;
    }

    // ── users/{uid} + subcollections ────────────────────────────────────
    match /users/{uid} {
      // Profile document
      allow read: if isOwner(uid) || isAdmin();

      // User profile bootstrap: only owner, role must start as user.
      allow create: if isOwner(uid)
                    && request.resource.data.role is string
                    && request.resource.data.role == 'user';

      // Owner can update own profile but cannot self-promote role.
      allow update: if (isOwner(uid)
                      && request.resource.data.role == resource.data.role
                      && validUserRole(resource.data.role))
                    || isAdmin();

      allow delete: if isAdmin();

      // cart stored at users/{uid}/cart/{itemId}
      match /cart/{itemId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCartItem();
        allow delete: if isOwner(uid);
      }

      // wishlist stored at users/{uid}/wishlist/{productId}
      match /wishlist/{productId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validWishlistItem();
        allow delete: if isOwner(uid);
      }
    }

    // ── products ─────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── categories ───────────────────────────────────────────────────────
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── orders ───────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isSignedIn()
                    && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() && validOrderCreate();

      // Order updates (status transitions etc.) are admin-controlled in app design.
      allow update, delete: if isAdmin();
    }

    // ── payments ─────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isSignedIn()
                    && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() && validPaymentCreate();

      // Client updates kept for current app flow; tighten to Cloud Functions in production.
      allow update: if isSignedIn()
                      && (resource.data.userId == request.auth.uid || isAdmin());

      allow delete: if isAdmin();
    }

    // ── Legacy wishlist path for migration ──────────────────────────────
    match /wishlist/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
